# =========================================================
# AtoriArt — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# Nunca comite o .env real no git.
# =========================================================

# Modo da aplicação: development | production
FLASK_ENV=development
FLASK_DEBUG=1

# -------- Segurança --------
# SECRET_KEY: assina cookies de sessão. NÃO é a senha do admin.
# Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Credenciais do administrador (usuário único)
ADMIN_USERNAME=admin

# Hash da senha (não a senha em texto puro).
# Gere com:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SuaSenhaForte'))"
ADMIN_PASSWORD_HASH=

# -------- Sessão --------
# Tempo de vida da sessão em minutos
SESSION_LIFETIME_MINUTES=60

# Cookie seguro: em produção (HTTPS) deve ser 1. Em dev local fica 0.
SESSION_COOKIE_SECURE=0
